# Identifiants de l'API Kaggle — copier ce fichier en .env et remplir UNE des options.
# Ne jamais commiter .env (il est dans .gitignore).

# Option A (recommandée) : jeton généré sur https://www.kaggle.com/settings/api
KAGGLE_API_TOKEN=

# Option B : ancienne clé API (contenu de kaggle.json)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Clé d'API ChurnGuard (en-tête X-API-Key). Vide = API non protégée (usage local uniquement).
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(32))"
CHURNGUARD_API_KEY=
